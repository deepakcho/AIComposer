{
  "name": "playground-react",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/playground-react/src",
  "projectType": "application",
  "tags": ["scope:app", "type:app", "framework:react"],
  "targets": {
    "serve": {
      "executor": "nx:run-commands",
      "options": { "command": "vite --port 4202", "cwd": "apps/playground-react" }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": { "command": "vite build", "cwd": "apps/playground-react" },
      "outputs": ["{projectRoot}/dist"]
    },
    "preview": {
      "executor": "nx:run-commands",
      "options": { "command": "vite preview", "cwd": "apps/playground-react" }
    }
  }
}
