{
  "name": "playground-vue",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/playground-vue/src",
  "projectType": "application",
  "tags": ["scope:app", "type:app", "framework:vue"],
  "targets": {
    "serve": {
      "executor": "nx:run-commands",
      "options": { "command": "vite --port 4203", "cwd": "apps/playground-vue" }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": { "command": "vite build", "cwd": "apps/playground-vue" },
      "outputs": ["{projectRoot}/dist"]
    }
  }
}
