{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "apps",
  "projects": {
    "angular": {
      "projectType": "application",
      "root": "packages/angular",
      "sourceRoot": "packages/angular/src",
      "prefix": "aic",
      "architect": {
        "storybook": {
          "builder": "@storybook/angular:start-storybook",
          "options": {
            "configDir": "packages/angular/.storybook",
            "browserTarget": "angular:build",
            "compodoc": false,
            "port": 6008,
            "tsConfig": "packages/angular/tsconfig.storybook.json"
          }
        },
        "build-storybook": {
          "builder": "@storybook/angular:build-storybook",
          "options": {
            "configDir": "packages/angular/.storybook",
            "browserTarget": "angular:build",
            "compodoc": false,
            "outputDir": "dist/storybook/angular",
            "test": true,
            "tsConfig": "packages/angular/tsconfig.storybook.json"
          }
        },
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/packages/angular-app",
            "index": "packages/angular/src/index.html",
            "browser": "packages/angular/src/main.ts",
            "tsConfig": "packages/angular/tsconfig.lib.json"
          },
          "configurations": {
            "development": {},
            "production": {
              "budgets": []
            }
          }
        }
      }
    }
  }
}
