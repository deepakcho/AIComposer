{
  "name": "ai-composer",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=18.19.0"
  },
  "scripts": {
    "build": "nx run-many -t build",
    "test": "nx run-many -t test",
    "lint": "nx run-many -t lint",
    "typecheck": "nx run-many -t typecheck",
    "e2e": "nx run-many -t e2e",
    "affected:build": "nx affected -t build",
    "affected:test": "nx affected -t test",
    "affected:lint": "nx affected -t lint",
    "dev:vanilla": "nx serve playground-vanilla",
    "dev:docs": "nx serve docs",
    "dev:react": "nx serve playground-react",
    "dev:vue": "nx serve playground-vue",
    "dev:angular": "nx serve playground-angular",
    "graph": "nx graph",
    "format": "prettier --write .",
    "release": "changeset version && pnpm install && pnpm build",
    "publish": "changeset publish",
    "storybook:react": "nx run react:storybook",
    "storybook:vue": "nx run vue:storybook",
    "storybook:angular": "nx run angular:storybook",
    "storybook:wc": "nx run web-component:storybook",
    "storybook:build": "nx run-many -t build-storybook",
    "docs:build": "nx run docs:build"
  },
  "devDependencies": {
    "@ai-composer/angular": "workspace:*",
    "@ai-composer/core": "workspace:*",
    "@ai-composer/dom": "workspace:*",
    "@ai-composer/plugin-command": "workspace:*",
    "@ai-composer/plugin-mention": "workspace:*",
    "@ai-composer/react": "workspace:*",
    "@ai-composer/testing": "workspace:*",
    "@ai-composer/themes": "workspace:*",
    "@ai-composer/vue": "workspace:*",
    "@ai-composer/web-component": "workspace:*",
    "@analogjs/vite-plugin-angular": "^1.9.0",
    "@angular/build": "^19.0.0",
    "@angular/cli": "^19.0.0",
    "@angular/common": "^19.0.0",
    "@angular/compiler": "^19.0.0",
    "@angular/compiler-cli": "^19.2.25",
    "@angular/core": "^19.0.0",
    "@angular/forms": "^19.0.0",
    "@angular/platform-browser": "^19.0.0",
    "@changesets/cli": "^2.27.9",
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.15.0",
    "@nx/eslint": "^21.0.0",
    "@nx/eslint-plugin": "^21.0.0",
    "@nx/js": "^21.0.0",
    "@nx/workspace": "^21.0.0",
    "@storybook/addon-a11y": "9",
    "@storybook/angular": "9",
    "@storybook/react-vite": "9",
    "@storybook/vue3-vite": "9",
    "@storybook/web-components-vite": "9",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitejs/plugin-vue": "^5.2.1",
    "eslint": "^9.15.0",
    "jsdom": "^25.0.1",
    "nx": "^21.0.0",
    "prettier": "^3.4.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rxjs": "^7.8.1",
    "storybook": "9",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.16.0",
    "vite": "^6.0.3",
    "vitest": "^2.1.8",
    "vue": "^3.5.13",
    "zone.js": "^0.15.0"
  }
}
